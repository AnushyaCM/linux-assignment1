(Q10) Write a script to calculate factorial of a number using for loop.

#!/bin/bash

# Prompt user for input
read -p "Enter a non-negative integer: " num

# Check if input is a non-negative integer
if ! [[ "$num" =~ ^[0-9]+$ ]]; then
    echo " Invalid input. Please enter a non-negative integer."
    exit 1
fi

# Initialize factorial result
factorial=1

# Use for loop to calculate factorial
for (( i=1; i<=num; i++ ))
do
    factorial=$((factorial * i))
done

# Display result
echo " Factorial of $num is: $factorial"


