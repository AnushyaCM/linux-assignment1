(Q2)  Write a bash script with a function that multiply two integer numbers.
#!/bin/bash
# Script with a function to multiply two integers

# Function to multiply two numbers
multiply() {
    local a=$1
    local b=$2
    local product=$((a * b))
    echo "$product"
}

# Read two integers from the user
read -p "Enter first integer: " num1
read -p "Enter second integer: " num2

# Call the multiply function and store result
result=$(multiply "$num1" "$num2")

# Display the result
echo "Product of $num1 and $num2 is: $result"
 









